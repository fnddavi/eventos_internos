# Configuração de produção local do Eventos Internos
# Copie para /etc/eventos-internos/eventos-internos.env com permissão 640 (root:eventos)
# NUNCA versione este arquivo preenchido no Git.

# Ambiente de execução (mantenha "production" no servidor)
EVENTOS_ENV=production
EVENTOS_DEBUG=0

# OBRIGATÓRIO em produção (mínimo de 32 caracteres).
# Gere com: python3 -c 'import secrets; print(secrets.token_hex(32))'
EVENTOS_SECRET_KEY=

# Endereço de escuta:
# Use o IP específico da interface de rede interna (LAN) deste servidor, ex.: 192.168.1.50.
# Evite expor em interfaces públicas ou na internet.
EVENTOS_HOST=127.0.0.1
EVENTOS_PORT=5000

# Número de threads do servidor Waitress (para 5-15 usuários simultâneos, 8 é adequado)
EVENTOS_THREADS=8

# Diretório local onde ficam eventos.json e uploads/
# Para manter os dados fora do diretório de código em produção:
EVENTOS_DATA_DIR=/var/lib/eventos-internos

# Limites de upload
EVENTOS_MAX_UPLOAD_MB=100
EVENTOS_MAX_FILES_PER_UPLOAD=20

# Defina 1 apenas se houver proxy reverso HTTPS local na frente do serviço
EVENTOS_SESSION_COOKIE_SECURE=0

# Nível de log enviado ao journald: DEBUG, INFO, WARNING, ERROR, CRITICAL
EVENTOS_LOG_LEVEL=INFO
