[Unit]
Description=Eventos Internos (Flask + Waitress) - uso exclusivo em rede interna
Documentation=file:///opt/eventos_internos/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eventos
Group=eventos
WorkingDirectory=/opt/eventos_internos
EnvironmentFile=/etc/eventos-internos/eventos-internos.env
ExecStart=/opt/eventos_internos/.venv/bin/python /opt/eventos_internos/wsgi.py

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Permissões restritivas para novos arquivos/diretórios criados pelo serviço
UMask=0027

# Endurecimento de isolamento no Linux (ajuste ReadWritePaths se mudar EVENTOS_DATA_DIR)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/eventos-internos

StandardOutput=journal
StandardError=journal
SyslogIdentifier=eventos-internos

[Install]
WantedBy=multi-user.target
